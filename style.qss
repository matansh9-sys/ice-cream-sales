
QWidget {
    background-color: #171d27;
    color: #d2d9e1;
    font-family: "Segoe UI";
    font-size: 13px;
}

QPushButton {
    background-color: #293746;
    color: #dce2e9;
    border: 1px solid #3b4a5a;
    border-radius: 6px;
    padding: 9px;
}

QPushButton:hover {
    background-color: #35475a;
    border: 1px solid #526a80;
}

QPushButton:pressed {
    background-color: #233140;
}

QPushButton:disabled {
    background-color: #202832;
    color: #788491;
    border: 1px solid #303b47;
}

QSpinBox {
    background-color: #242f3d;
    color: #d2d9e1;
    border: 1px solid #405062;
    border-radius: 6px;
    padding: 7px;
}

QSpinBox:focus {
    background-color: #293746;
    border: 1px solid #647b91;
}

QSpinBox::up-button,
QSpinBox::down-button {
    background-color: #303d4b;
    border: none;
    width: 20px;
}

QTableWidget {
    background-color: #202a36;
    alternate-background-color: #26313e;
    color: #d2d9e1;
    gridline-color: #35414e;
    border: 1px solid #3b4857;
    border-radius: 6px;
    selection-background-color: #40556b;
    selection-color: #f0f3f6;
}

QTableWidget::item {
    padding: 4px;
}

QTableWidget::item:hover {
    background-color: #304052;
}

QHeaderView::section {
    background-color: #313d4a;
    color: #dce2e9;
    padding: 8px;
    border: none;
    border-right: 1px solid #43505e;
    border-bottom: 1px solid #43505e;
    font-weight: bold;
}

QTableCornerButton::section {
    background-color: #313d4a;
    border: 1px solid #43505e;
}

QScrollBar:vertical {
    background-color: #1b2530;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #435263;
    border-radius: 5px;
    min-height: 25px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #526578;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QMessageBox {
    background-color: #1d2733;
    color: #d2d9e1;
}

QPushButton {
    background-color: #35475a;
    color: #e0e5eb;
    border: 1px solid #526a80;
}
